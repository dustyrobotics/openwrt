+static u64 last_rx_kernel_time_ns = 0;
+static DEFINE_SPINLOCK(tsf_sync_lock);
+
+/* Forward declaration for TSF sync function */
+static void morse_capture_rx_tsf(const struct morse_skb_rx_status *hdr_rx_status);
