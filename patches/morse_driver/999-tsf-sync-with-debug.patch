+/**
+ * tsf_rx_show - Display last received frame's TSF
+ *
+ * Shows the TSF timestamp captured from the last received frame (ANY type).
+ * This is used by CLIENTS (Gateway/Station) to determine when a packet arrived.
+ *
+ * Output format:
+ *   TSF: <hardware_tsf_us>
+ *   SYS: <kernel_time_ns>
+ */
+static int tsf_rx_show(struct seq_file *m, void *v)
+{
+	u64 hw_tsf_us, kernel_time_ns;
+
+	morse_get_tsf_snapshot(&hw_tsf_us, &kernel_time_ns);
+
+	seq_printf(m, "TSF: %llu\n", hw_tsf_us);
+	seq_printf(m, "SYS: %llu\n", kernel_time_ns);
+
+	return 0;
+}
+
+DEFINE_SHOW_ATTRIBUTE(tsf_rx);
+
+/**
+ * tsf_current_show - Display extrapolated current TSF
+ *
+ * Calculates the current TSF by extrapolating from the last received frame.
+ * Formula: current_tsf = last_rx_tsf + (current_time - last_rx_time)
+ *
+ * This is used by APs (Robot/Master) to get the current hardware time
+ * for broadcasting in time sync packets.
+ *
+ * Output format:
+ *   TSF: <current_tsf_us>
+ *   SYS: <current_kernel_time_ns>
+ *
+ * Note: TSF increments at 1 MHz (1 tick per microsecond), so we can
+ * accurately extrapolate by adding the time delta.
+ */
+static int tsf_current_show(struct seq_file *m, void *v)
+{
+	u64 last_hw_tsf_us, last_kernel_time_ns;
+	u64 current_kernel_time_ns;
+	u64 delta_ns, delta_us;
+	u64 current_tsf_us;
+
+	/* Get last captured values */
+	morse_get_tsf_snapshot(&last_hw_tsf_us, &last_kernel_time_ns);
+
+	/* Get current kernel time */
+	current_kernel_time_ns = ktime_get_real_ns();
+
+	/* Calculate time delta and extrapolate TSF */
+	delta_ns = current_kernel_time_ns - last_kernel_time_ns;
+	delta_us = delta_ns / 1000;  /* Convert ns to us */
+	current_tsf_us = last_hw_tsf_us + delta_us;
+
+	seq_printf(m, "TSF: %llu\n", current_tsf_us);
+	seq_printf(m, "SYS: %llu\n", current_kernel_time_ns);
+
+	return 0;
+}
+
+DEFINE_SHOW_ATTRIBUTE(tsf_current);
+
+/**
+ * rx_debug_counters_show - Display RX path debug counters
+ *
+ * Shows atomic counters used to trace execution flow through RX path.
+ * Useful for debugging TSF capture issues and understanding which
+ * code paths are executed during frame reception.
+ *
+ * Output format:
+ *   morse_mac_skb_recv_calls: <count>
+ *   morse_capture_rx_tsf_calls: <count>
+ *   morse_mac_skb_recv_early_returns: <count>
+ */
+static int rx_debug_counters_show(struct seq_file *m, void *v)
+{
+	seq_printf(m, "morse_mac_skb_recv_calls: %d\n",
+		   atomic_read(&morse_mac_skb_recv_calls));
+	seq_printf(m, "morse_capture_rx_tsf_calls: %d\n",
+		   atomic_read(&morse_capture_rx_tsf_calls));
+	seq_printf(m, "morse_mac_skb_recv_early_returns: %d\n",
+		   atomic_read(&morse_mac_skb_recv_early_returns));
+
+	return 0;
+}
+
+DEFINE_SHOW_ATTRIBUTE(rx_debug_counters);
